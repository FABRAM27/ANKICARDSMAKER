/* ============================================================
   HYBRID MULTILINGUAL ANKI CARD — SHARED STYLING

   Paste this entire file into Anki > Cards > Styling.
   The font loader accepts the user's current GoogleFont.ttf name
   and the Anki-recommended _GoogleFont.ttf alternative.
   ============================================================ */

@font-face {
  font-family: "Hybrid Google Sans";
  src:
    url("_GoogleFont.ttf") format("truetype"),
    url("GoogleFont.ttf") format("truetype");
  font-weight: 100 900;
  font-style: normal;
  font-display: swap;
}

/* Keep the same light appearance in normal and Anki night mode. */
.card,
.card.nightMode,
.nightMode .card {
  margin: 0 !important;
  padding: 0 !important;
  min-height: 100vh;
  background:
    radial-gradient(circle at 50% -18%, rgba(255, 255, 255, 0.98) 0, rgba(255, 255, 255, 0.98) 30%, rgba(255, 255, 255, 0) 62%),
    #f7f7f8 !important;
  color: #111114 !important;
  font-family:
    "Hybrid Google Sans",
    "Google Sans",
    "Product Sans",
    "Segoe UI Variable Display",
    "Segoe UI",
    Roboto,
    Arial,
    sans-serif !important;
  text-align: center;
  -webkit-font-smoothing: antialiased;
  -webkit-text-size-adjust: 100%;
  text-rendering: optimizeLegibility;
}

.hybrid-card,
.hybrid-card *,
.hybrid-card *::before,
.hybrid-card *::after {
  box-sizing: border-box;
}

.hybrid-card {
  width: 100%;
  max-width: 820px;
  min-height: 90vh;
  min-height: calc(100vh - 20px);
  margin: 0 auto;
  padding: 32px 20px 28px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 52px;
  background: transparent;
  color: #111114;
}

.hybrid-sr-only {
  position: absolute !important;
  width: 1px !important;
  height: 1px !important;
  padding: 0 !important;
  margin: -1px !important;
  overflow: hidden !important;
  clip: rect(0, 0, 0, 0) !important;
  white-space: nowrap !important;
  border: 0 !important;
}

/* ============================================================
   LANGUAGE ROWS
   ============================================================ */

.hybrid-top-section {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 15px;
}

.hybrid-language-row {
  width: 100%;
  max-width: 680px;
  min-width: 0;
  display: grid;
  grid-template-columns: 48px 44px minmax(0, 1fr);
  align-items: center;
  gap: 15px;
  margin: 0 auto;
  transition:
    width 180ms ease,
    max-width 180ms ease,
    gap 180ms ease,
    grid-template-columns 180ms ease;
}

/* ============================================================
   HYBRID PLAY CONTROL

   The browser button sits underneath Anki's generated replay
   button. If Anki supplies native TTS, its real control receives
   the click. If it does not, the browser button remains available.
   JavaScript intercepts either control only when a preferred
   Online/Natural browser voice is available.
   ============================================================ */

.hybrid-play-slot {
  position: relative;
  width: 48px;
  height: 48px;
  min-width: 48px;
  min-height: 48px;
  justify-self: center;
  border-radius: 50%;
  isolation: isolate;
}

.hybrid-play-slot::before {
  content: "";
  position: absolute;
  z-index: 0;
  top: -5px;
  right: -5px;
  bottom: -5px;
  left: -5px;
  border: 2px solid rgba(0, 0, 0, 0.14);
  border-radius: 50%;
  opacity: 0;
  transform: scale(0.88);
  pointer-events: none;
}

.hybrid-web-play,
.hybrid-native-tts .replay-button,
.hybrid-native-tts .replaybutton,
.hybrid-native-tts .soundLink {
  position: absolute !important;
  top: 0 !important;
  right: 0 !important;
  bottom: 0 !important;
  left: 0 !important;
  width: 48px !important;
  height: 48px !important;
  min-width: 48px !important;
  min-height: 48px !important;
  margin: 0 !important;
  padding: 0 !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  border: 0 !important;
  border-radius: 50% !important;
  background: #000 !important;
  color: #fff !important;
  box-shadow: 0 5px 14px rgba(0, 0, 0, 0.17) !important;
  cursor: pointer !important;
  text-decoration: none !important;
  -webkit-tap-highlight-color: transparent;
  transition:
    transform 160ms ease,
    box-shadow 160ms ease,
    opacity 160ms ease !important;
}

.hybrid-web-play {
  z-index: 1;
  appearance: none;
  -webkit-appearance: none;
}

.hybrid-native-tts {
  position: absolute;
  z-index: 2;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 48px;
  height: 48px;
  overflow: hidden;
  color: transparent;
  font-size: 0;
  pointer-events: none;
}

.hybrid-native-tts .replay-button,
.hybrid-native-tts .replaybutton,
.hybrid-native-tts .soundLink {
  z-index: 2;
  pointer-events: auto !important;
}

/* Hide Anki's varying SVG so every platform gets one icon. */
.hybrid-native-tts .replay-button svg,
.hybrid-native-tts .replaybutton svg,
.hybrid-native-tts .soundLink svg {
  display: none !important;
}

.hybrid-play-glyph {
  position: absolute;
  z-index: 5;
  top: 50%;
  left: 50%;
  width: 0;
  height: 0;
  transform: translate(-38%, -50%);
  border-top: 8px solid transparent;
  border-bottom: 8px solid transparent;
  border-left: 12px solid #fff;
  pointer-events: none;
}

.hybrid-play-slot.is-loading .hybrid-web-play,
.hybrid-play-slot.is-speaking .hybrid-web-play,
.hybrid-play-slot.is-speaking .replay-button,
.hybrid-play-slot.is-speaking .replaybutton,
.hybrid-play-slot.is-speaking .soundLink,
.hybrid-play-slot.is-native-active .hybrid-web-play,
.hybrid-play-slot.is-native-active .replay-button,
.hybrid-play-slot.is-native-active .replaybutton,
.hybrid-play-slot.is-native-active .soundLink {
  box-shadow:
    0 5px 14px rgba(0, 0, 0, 0.17),
    0 0 0 5px rgba(255, 120, 178, 0.20) !important;
}

.hybrid-play-slot.is-loading::before,
.hybrid-play-slot.is-speaking::before,
.hybrid-play-slot.is-native-active::before {
  opacity: 1;
  animation: hybrid-listening-pulse 1.35s ease-out infinite;
}

@keyframes hybrid-listening-pulse {
  0% {
    opacity: 0.62;
    transform: scale(0.88);
  }
  100% {
    opacity: 0;
    transform: scale(1.32);
  }
}

.hybrid-web-play:active,
.hybrid-native-tts .replay-button:active,
.hybrid-native-tts .replaybutton:active,
.hybrid-native-tts .soundLink:active {
  transform: scale(0.96) !important;
}

.hybrid-web-play:focus,
.hybrid-native-tts .replay-button:focus,
.hybrid-native-tts .replaybutton:focus,
.hybrid-native-tts .soundLink:focus {
  outline: 3px solid rgba(255, 120, 178, 0.54) !important;
  outline-offset: 4px !important;
}

/* AnkiWeb can leave an unsupported TTS marker as text. Hide it. */
.hybrid-play-slot.hybrid-no-native .hybrid-native-tts {
  display: none !important;
}

/* ============================================================
   FLAGS
   ============================================================ */

.hybrid-flag {
  width: 44px;
  height: 44px;
  display: block;
  justify-self: center;
  overflow: hidden;
  border-radius: 50%;
  background: #fff;
  box-shadow:
    0 2px 7px rgba(0, 0, 0, 0.11),
    inset 0 0 0 1px rgba(0, 0, 0, 0.06);
}

.hybrid-flag svg {
  display: block;
  width: 100%;
  height: 100%;
}

/* ============================================================
   TEXT PILLS
   ============================================================ */

.hybrid-pill {
  width: 100%;
  min-width: 0;
  min-height: 52px;
  padding: 14px 24px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid rgba(22, 22, 26, 0.025);
  border-radius: 999px;
  background: #fff;
  box-shadow: 0 4px 15px rgba(24, 24, 30, 0.06);
  color: #303036;
  font-size: 16px;
  font-weight: 500;
  line-height: 1.45;
  word-wrap: break-word;
  overflow-wrap: anywhere;
}

.hybrid-speak-text {
  display: block;
  width: 100%;
  min-width: 0;
}

.hybrid-answer-accent {
  color: #d65d5d;
}

/* ============================================================
   BOTTOM SECTION AND TOGGLES
   ============================================================ */

.hybrid-bottom-section {
  width: 100%;
  max-width: 720px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 17px;
}

.hybrid-toggles-row {
  width: 100%;
  padding: 0 4px;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  align-items: end;
  gap: 18px;
}

.hybrid-toggle-group {
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  gap: 9px;
  color: #111114;
  cursor: pointer;
  user-select: none;
  -webkit-user-select: none;
}

.hybrid-toggle-label {
  max-width: 170px;
  font-size: 14px;
  font-weight: 600;
  line-height: 1.3;
}

.hybrid-switch {
  position: relative;
  width: 50px;
  height: 28px;
  flex: 0 0 auto;
}

.hybrid-switch input {
  position: absolute;
  z-index: 2;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
  margin: 0;
  opacity: 0;
  cursor: pointer;
}

.hybrid-slider {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  border: 2px solid #c8c8cf;
  border-radius: 999px;
  background: #fff;
  transition: border-color 190ms ease, box-shadow 190ms ease;
}

.hybrid-slider::before {
  content: "";
  position: absolute;
  width: 18px;
  height: 18px;
  left: 3px;
  top: 3px;
  border-radius: 50%;
  background: #c8c8cf;
  transition: transform 190ms ease, background 190ms ease;
}

.hybrid-switch input:checked + .hybrid-slider {
  border-color: #ff7eb4;
  box-shadow: 0 3px 10px rgba(255, 126, 180, 0.16);
}

.hybrid-switch input:checked + .hybrid-slider::before {
  transform: translateX(22px);
  background: linear-gradient(135deg, #ffbf9f, #ff78b2);
}

.hybrid-switch input:focus + .hybrid-slider {
  outline: 3px solid rgba(255, 120, 178, 0.42);
  outline-offset: 3px;
}

/* ============================================================
   FIELD 1 + FIELD 2
   ============================================================ */

.hybrid-bottom-fields {
  width: 100%;
  display: none;
  flex-direction: column;
  align-items: center;
  gap: 13px;
}

.hybrid-big-pill {
  width: auto;
  width: fit-content;
  max-width: 100%;
  min-width: 0;
  min-height: 0;
  padding: 15px 25px;
  justify-content: flex-start;
  text-align: left;
  white-space: normal;
  word-break: normal;
  word-wrap: break-word;
  overflow-wrap: anywhere;
}

.hybrid-speech-status {
  min-height: 22px;
  margin: 0;
  color: #66666f;
  font-size: 13px;
  line-height: 1.4;
}

.hybrid-speech-status.is-error {
  color: #a52c42;
}

/* ============================================================
   SHOW-STATE LAYOUT
   ============================================================ */

.hybrid-card:not(.show-flags) .hybrid-flag {
  display: none;
}

.hybrid-card:not(.show-flags).show-top-fields .hybrid-language-row {
  max-width: 620px;
  grid-template-columns: 48px minmax(0, 1fr);
}

.hybrid-card:not(.show-top-fields) .hybrid-top-pill {
  display: none;
}

.hybrid-card.show-flags:not(.show-top-fields) .hybrid-language-row {
  width: auto;
  max-width: none;
  grid-template-columns: 48px 44px;
}

.hybrid-card:not(.show-flags):not(.show-top-fields) .hybrid-language-row {
  width: auto;
  max-width: none;
  grid-template-columns: 48px;
}

.hybrid-card.show-bottom-fields .hybrid-bottom-fields {
  display: flex;
  animation: hybrid-reveal-fields 180ms ease both;
}

@keyframes hybrid-reveal-fields {
  from {
    opacity: 0;
    transform: translateY(5px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Hover effects only on devices with a real pointing device. */
@media (hover: hover) and (pointer: fine) {
  .hybrid-web-play:hover,
  .hybrid-native-tts .replay-button:hover,
  .hybrid-native-tts .replaybutton:hover,
  .hybrid-native-tts .soundLink:hover {
    transform: translateY(-1px) !important;
    box-shadow: 0 8px 18px rgba(0, 0, 0, 0.21) !important;
  }
}

/* ============================================================
   PHONE / ANKI MOBILE LAYOUT
   ============================================================ */

@media (max-width: 600px) {
  .hybrid-card {
    min-height: calc(100vh - 12px);
    padding: 22px 10px 16px;
    gap: 34px;
  }

  .hybrid-top-section {
    gap: 12px;
  }

  .hybrid-language-row {
    grid-template-columns: 44px 38px minmax(0, 1fr);
    gap: 10px;
  }

  .hybrid-play-slot,
  .hybrid-web-play,
  .hybrid-native-tts,
  .hybrid-native-tts .replay-button,
  .hybrid-native-tts .replaybutton,
  .hybrid-native-tts .soundLink {
    width: 44px !important;
    height: 44px !important;
    min-width: 44px !important;
    min-height: 44px !important;
  }

  .hybrid-flag {
    width: 38px;
    height: 38px;
  }

  .hybrid-pill {
    min-height: 48px;
    padding: 12px 16px;
    font-size: 15px;
  }

  .hybrid-toggles-row {
    grid-template-columns: 1fr;
    gap: 6px;
    padding: 7px 4px;
    border-radius: 24px;
    background: rgba(255, 255, 255, 0.56);
  }

  .hybrid-toggle-group {
    min-height: 44px;
    padding: 2px 10px 2px 13px;
    flex-direction: row;
    justify-content: space-between;
    gap: 18px;
    text-align: left;
  }

  .hybrid-toggle-label {
    max-width: none;
  }

  .hybrid-card:not(.show-flags).show-top-fields .hybrid-language-row {
    grid-template-columns: 44px minmax(0, 1fr);
  }

  .hybrid-card.show-flags:not(.show-top-fields) .hybrid-language-row {
    grid-template-columns: 44px 38px;
  }

  .hybrid-card:not(.show-flags):not(.show-top-fields) .hybrid-language-row {
    grid-template-columns: 44px;
  }
}

@media (max-width: 370px) {
  .hybrid-card {
    padding-right: 7px;
    padding-left: 7px;
  }

  .hybrid-language-row {
    gap: 8px;
  }

  .hybrid-pill {
    padding-right: 13px;
    padding-left: 13px;
    font-size: 14px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .hybrid-card *,
  .hybrid-card *::before,
  .hybrid-card *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}

